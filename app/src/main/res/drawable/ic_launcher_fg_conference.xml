<?xml version="1.0" encoding="utf-8"?>
<!--
    Adaptive icon foreground for the Conference Hub: a video camera above a group of three people.
    The front person gets a thin stroke in the background colour so the three silhouettes read as
    separate figures, as in the reference artwork.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- 24-unit artwork scaled to 54dp and centred inside the 66dp safe zone. -->
    <group
        android:scaleX="2.25"
        android:scaleY="2.25"
        android:translateX="27"
        android:translateY="27">
        <!-- Camera body + lens -->
        <path
            android:fillColor="@color/ic_launcher_fg_conference_hub"
            android:pathData="M7,2.5 h7 a1,1 0 0 1 1,1 v4.4 a1,1 0 0 1 -1,1 h-7 a1,1 0 0 1 -1,-1 V3.5 a1,1 0 0 1 1,-1 z" />
        <path
            android:fillColor="@color/ic_launcher_fg_conference_hub"
            android:pathData="M15,4.6 L18,3.2 V8.2 L15,6.8 Z" />
        <!-- Back row: left and right person -->
        <path
            android:fillColor="@color/ic_launcher_fg_conference_hub"
            android:pathData="M4.6,13.2 a2,2 0 1 0 4,0 a2,2 0 1 0 -4,0 z M2.4,21 C2.4,17.6 4.2,16 6.6,16 C9,16 10.8,17.6 10.8,21 Z" />
        <path
            android:fillColor="@color/ic_launcher_fg_conference_hub"
            android:pathData="M15.4,13.2 a2,2 0 1 0 4,0 a2,2 0 1 0 -4,0 z M13.2,21 C13.2,17.6 15,16 17.4,16 C19.8,16 21.6,17.6 21.6,21 Z" />
        <!-- Front person, outlined in the background colour to separate it from the back row -->
        <path
            android:fillColor="@color/ic_launcher_fg_conference_hub"
            android:pathData="M9.5,12.6 a2.5,2.5 0 1 0 5,0 a2.5,2.5 0 1 0 -5,0 z"
            android:strokeColor="@color/ic_launcher_bg"
            android:strokeWidth="0.7" />
        <path
            android:fillColor="@color/ic_launcher_fg_conference_hub"
            android:pathData="M6.8,21.5 C6.8,17.5 9,15.6 12,15.6 C15,15.6 17.2,17.5 17.2,21.5 Z"
            android:strokeColor="@color/ic_launcher_bg"
            android:strokeWidth="0.7" />
    </group>
</vector>
